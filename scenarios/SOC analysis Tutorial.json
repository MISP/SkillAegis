        {
            "name": "Report from CSIRT received",
            "action": "",
            "target_tool": "MISP",
            "uuid": "2b7930e0-cd24-4df4-9302-df69ae785475",
            "description": "A European CSIRT sends a report (MISP event #1) to an ISAC where the SOC is a member.",
            "inject_evaluation": [
                {
                    "parameters": [
                        {
                            ".response[].Event.uuid": {
                                "comparison": "equals",
                                "values": [
                                    "1d34bc17-4861-4ad7-b73e-cd1695a754af"
                                ]
                            }
                        }
                    ],
                    "result": "",
                    "evaluation_strategy": "query_search",
                    "evaluation_context": {
                        "request_is_rest": false,
                        "query_context": {
                            "url": "/events/restSearch",
                            "request_method": "POST",
                            "payload": {
                                "eventid": "1d34bc17-4861-4ad7-b73e-cd1695a754af"
                            }
                        }
                    },
                    "score_range": [
                        0,
                        20
                    ]
                }
            ],
            "inject_evaluation_join_type": null
        },
        {
